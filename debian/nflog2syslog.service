[Unit]
Description=nflog2syslog: NFLOG to JSON syslog transport daemon
After=network-online.target

[Service]
# No persistent user needed: the daemon writes nothing to disk (stdout ->
# journald, remote syslog, netlink in). DynamicUser= implies NoNewPrivileges=,
# RestrictSUIDSGID=, PrivateTmp=, ProtectSystem=strict, ProtectHome=read-only,
# RemoveIPC=. CAP_NET_ADMIN (ambient, only cap in the bounding set) is required
# for the NFLOG netlink config handshake and SO_RCVBUFFORCE.
DynamicUser=yes
EnvironmentFile=-/etc/default/nflog2syslog
ExecStart=/usr/sbin/nflog2syslog --dest=${DEST} --proto=${PROTO} --stdout=${LOG_STDOUT} --nflog-group=${NFLOG_GROUP} --stats-interval=${STATS_INTERVAL} --metrics-addr=${METRICS_ADDR}
Restart=always
RestartSec=10s
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

LockPersonality=true
PrivateDevices=false
PrivateUsers=false
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
