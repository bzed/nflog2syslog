#!/usr/bin/make -f
# Plain debhelper + cargo (see Makefile "vendor" target for offline builds:
# it creates vendor/ plus .cargo/config.toml so no network is needed).
#
# Debian's rustc is often older than the dependencies need (time 0.3.55
# requires 1.88), so builds can point CARGO at a rustup-installed cargo:
#   CARGO=$HOME/.cargo/bin/cargo dpkg-buildpackage -us -uc -b -d

CARGO ?= cargo

# prefer distro cargo over rustup shims when both are installed (rustup
# proxies cannot always resolve a toolchain in the build environment)
export PATH := /usr/bin:/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	rm -rf target

override_dh_auto_build:
	$(CARGO) build --release --locked

override_dh_auto_test:
	$(CARGO) test --release --locked

override_dh_dwz:
	# dwz fails on Rust binaries; cargo already stripped the release build
