#!/usr/bin/make -f
# Plain debhelper + cargo (see Makefile "vendor" target for offline builds:
# it creates vendor/ plus .cargo/config.toml so no network is needed).
#
# Debian's rustc is often older than the dependencies need (time 0.3.55
# requires 1.88), so builds can point CARGO at a rustup-installed cargo:
#   CARGO=$HOME/.cargo/bin/cargo dpkg-buildpackage -us -uc -b -d

# CARGO/RUSTC can point at specific binaries (e.g. a rustup toolchain).
# NOTE: an empty value in the environment counts as defined for make,
# so ?= alone does not fall back - use $(or ...).
CARGO := $(or $(strip $(CARGO)),cargo)
# cargo must not reach rustc through a rustup shim: shims may try to
# download missing toolchain components (rust-src) during the build,
# and parallel rustc invocations race inside ~/.rustup/downloads.
# RUSTC is exported so cargo picks it up.
RUSTC := $(or $(strip $(RUSTC)),rustc)
export RUSTC

# prefer distro cargo over rustup shims when both are installed (rustup
# proxies cannot always resolve a toolchain in the build environment)
export PATH := /usr/bin:/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	rm -rf target

override_dh_auto_build:
	$(CARGO) build --release --locked

override_dh_auto_test:
	$(CARGO) test --release --locked

override_dh_dwz:
	# dwz fails on Rust binaries; cargo already stripped the release build
